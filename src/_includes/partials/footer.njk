<!-- ===== Footer (auf jeder Seite gleich) ===== -->
<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">Nebel Lounge</div>
        <p>
          {{ site.street }}<br />
          {{ site.postalCode }} {{ site.city }}<br />
          <a href="{{ site.phone.href }}">{{ site.phone.display }}</a>
        </p>
      </div>
      <div>
        <h3>Seiten</h3>
        <ul>
{%- for item in nav %}{% if not item.cta %}
          <li><a href="{{ item.href }}">{{ item.label }}</a></li>
{%- endif %}{% endfor %}
        </ul>
      </div>
      <div>
        <h3>Folgen</h3>
        <ul>
          <li><a href="{{ site.instagram.url }}">Instagram</a></li>
          <li><a href="{{ site.whatsapp }}">WhatsApp</a></li>
          <li><a href="{{ site.maps }}">Anfahrt</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{{ site.ageNotice }}</span>
      <span><a href="impressum.html">Impressum</a> · <a href="datenschutz.html">Datenschutz</a></span>
    </div>
  </div>
</footer>
