<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
{# setzt .js, bevor CSS lädt — siehe html.js .reveal in effects.css #}
<script>document.documentElement.className += " js";</script>
<title>{{ title | safe }}</title>
<meta name="description" content="{{ description | safe }}" />
<link rel="icon" href="img/favicon.svg" type="image/svg+xml" />
<link rel="canonical" href="{{ site.url }}{{ page.url }}" />
{%- if ogDescription %}
<meta property="og:title" content="{{ title | safe }}" />
<meta property="og:description" content="{{ ogDescription | safe }}" />
<meta property="og:type" content="website" />
{%- endif %}
<!-- effects.css zuletzt: der reduced-motion-Block gewinnt über die Reihenfolge -->
<link rel="stylesheet" href="css/tokens.css" />
<link rel="stylesheet" href="css/base.css" />
<link rel="stylesheet" href="css/components.css" />
<link rel="stylesheet" href="css/effects.css" />
{% include "partials/schema.njk" %}
</head>
<body>

<a class="skip" href="#main">Zum Inhalt springen</a>

{% include "partials/header.njk" %}

<main id="main">
{{ content | safe }}
</main>

{% include "partials/footer.njk" %}

<script src="js/main.js"></script>
</body>
</html>
